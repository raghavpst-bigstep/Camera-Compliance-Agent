# ---------------------------------------------------------------------------
# Copy to .env for local runs. Never commit a filled-in copy.
# On Cloud Run these are set with --set-env-vars, not from a file.
# ---------------------------------------------------------------------------

# --- shared ---------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
LOG_LEVEL=INFO
# Transport timeout for every Google API client call, in seconds.
GOOGLE_HTTP_TIMEOUT_SECONDS=30

# --- agent service --------------------------------------------------------
# Route Gemini calls through Vertex AI rather than the AI Studio key path.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# "global" uses Gemini's global endpoint; a region such as us-central1 also works.
GOOGLE_CLOUD_LOCATION=global
MODEL_ID=gemini-2.5-flash

# The employee master sheet. Share it with the service account as Viewer.
# Header row must include an employee name or email column; manager and HR
# columns are matched by name (see agent/camera_agent/directory.py).
EMPLOYEE_SHEET_ID=
EMPLOYEE_SHEET_RANGE=Employees!A:Z
DIRECTORY_CACHE_TTL_SECONDS=300

# --- orchestrator ---------------------------------------------------------
# The HR mailbox that receives manager reports. Every Gmail and Chat action is
# performed as this identity via domain-wide delegation.
COMPLIANCE_MAILBOX=camera-compliance@yourcompany.com

# The service account this container runs as; it is the DWD issuer and needs
# roles/iam.serviceAccountTokenCreator on itself.
SERVICE_ACCOUNT_EMAIL=camera-agent@your-project-id.iam.gserviceaccount.com

# The agent service's Cloud Run URL (deploy the agent first).
AGENT_URL=https://camera-agent-xxxxxxxx-uc.a.run.app

# The audit sheet. Share it with the service account as Editor.
AUDIT_SHEET_ID=
AUDIT_SHEET_RANGE=Audit!A:N

GMAIL_TOPIC=projects/your-project-id/topics/incoming-mail
CHAT_EVENTS_TOPIC=projects/your-project-id/topics/chat-events

FIRESTORE_DATABASE=(default)

# Half a day, per the workflow spec.
RESPONSE_PERIOD_HOURS=12
# Set this during testing to shorten the clock; it overrides the hours above.
# RESPONSE_PERIOD_MINUTES=2
MAX_REMINDERS=3
WATCH_RENEW_WITHIN_DAYS=2
EVENT_SUBSCRIPTION_TTL_HOURS=168

# Chat space title. {incident_id} and {employee_name} are substituted.
SPACE_NAME_TEMPLATE=Camera Compliance {incident_id} - {employee_name}

# Prefixed to every message the agent posts, and signed on the email reply.
AGENT_DISPLAY_NAME=Camera Compliance Agent

REMINDER_TEMPLATE=Reminder: a response is still outstanding on this incident. Please reply in this space.
